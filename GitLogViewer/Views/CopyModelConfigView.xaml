<Window x:Class="ModelConfigProMax.Views.CopyModelConfigView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:ModelConfigProMax.Views"
        mc:Ignorable="d"
        WindowStartupLocation="CenterScreen"
        Height="500" Width="850">
  
    <Grid>
        <GroupBox FontSize="18" Foreground="White">
            <GroupBox.Header>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="35"/>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="35" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <TextBlock Grid.Row="0" Text="Choose BaseUnits" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="0" x:Name="TextBoxSearchBaseUnit" Text="{Binding SearchBaseUnit,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="160,0,0,0" Width="638" Height="30">
                    </TextBox>
                    <Grid Grid.Row="1">
                        <StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Visible" Height="150" CanContentScroll="True"
                                          MouseWheel="ScrollViewer_MouseWheel" PanningMode="Both">
                                <!-- display all variant -->
                                <DataGrid ItemsSource="{Binding ListBaseUnits}" AutoGenerateColumns="False" Height="Auto" 
                                          ScrollViewer.CanContentScroll="True"
                                          MouseWheel="DataGrid_MouseWheel"> 
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Select">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected_BaseUnits, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                              HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="BaseUnit" FontSize="13" Binding="{Binding Path=BaseUnit.Name}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                    <TextBlock Grid.Row="2" Text="Choose AppNames" Margin="10,0,0,0" VerticalAlignment="Center"/>
                    <TextBox Grid.Row="2" x:Name="TextBoxSearchApp" Text="{Binding SearchAppName,Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                            FontSize="13" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="160,0,0,0" Width="638" Height="30">
                    </TextBox>
                    <Grid Grid.Row="3">
                        <StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Visible" Height="150" CanContentScroll="True"
                                          MouseWheel="ScrollViewer_MouseWheel" PanningMode="Both">
                                <!-- display all appname -->
                                <DataGrid ItemsSource="{Binding ListAppNames}" AutoGenerateColumns="False" Height="Auto" 
                                          ScrollViewer.CanContentScroll="True"
                                          MouseWheel="DataGrid_MouseWheel"> 
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Header="Select">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox IsChecked="{Binding IsSelected_AppNames, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" 
                                                              HorizontalAlignment="Center"/>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTextColumn Header="AppName" FontSize="13" Binding="{Binding Path=AppName.Name}" Width="*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </ScrollViewer>
                        </StackPanel>
                    </Grid>
                    <StackPanel Grid.Row="4" HorizontalAlignment="Right" Margin="0,5,14,0">
                        <Button Content="Submit"  Width="120" Height="25" Command="{Binding SubmitBaseUnitClickCommand}"/>
                    </StackPanel>
                </Grid>
            </GroupBox.Header>
        </GroupBox>
    </Grid>
</Window>
